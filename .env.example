APP_ENV=development

# Lokal Windows kullanimi icin en kolay secenek:
DATABASE_URL=sqlite:///data/football_analytics.db

# Docker icinde SQLite kullanacaksan bunu kullan:
# DATABASE_URL=sqlite:///data/football_analytics.db

# Veri kaynaklari
USE_IDDAA_SOURCE=1
USE_NESINE_SOURCE=0

# Bazi Windows ortamlarda TLS dogrulama sorun cikarsa gecici olarak 0 yapabilirsin.
IDDAA_VERIFY_SSL=1

# Scheduler ayarlari
INGEST_INTERVAL_MINUTES=30
FORCE_DEMO_SEED_ON_START=0
RUN_TRAIN_AFTER_INGEST=1
RUN_PREDICT_AFTER_TRAIN=1

# Uygulama
STREAMLIT_SERVER_PORT=8502
LOG_LEVEL=INFO
